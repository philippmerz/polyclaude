# NEVER commit secrets
wallet.json
wallet_crypto.json
*.key
*.pem
.env
.env.*
*secret*
*private*
*mnemonic*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
scripts/clob_node/package-lock.json

# Logs may contain addresses, balances, order ids - keep local
logs/
*.log

# Runtime lockfiles (flock-based cross-tick mutex)
.checkin.lock

# Operator self-followup PID file (operator_followup.sh / cancel_followup.sh)
notes/.followup_pid

# Local cache of market data — re-generatable, would bloat repo
# data/ contains methodology snapshots, shortlists, prospective-resolve results.
# All subdirs (raw/, cache/, snapshots/, methodology/) are regenerable from
# scripts; nothing here is source of truth for decisions (those live in journal).
data/

# Editor swap files
*.swp
*.swo
.*.swp
.*.swo

# OS
.DS_Store
notes/.uma_status_cache.json
notes/entries_log.md
